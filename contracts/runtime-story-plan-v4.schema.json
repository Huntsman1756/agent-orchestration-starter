{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-story-plan-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "contract_hash", "base_sha", "worker_capability_hash", "max_iterations", "stories", "plan_hash"],
  "properties": {
    "schema_version": { "const": 4 },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]{16,96}$" },
    "contract_hash": { "$ref": "#/$defs/hash" },
    "base_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "worker_capability_hash": { "$ref": "#/$defs/hash" },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 64 },
    "stories": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/story" } },
    "plan_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "storyId": { "type": "string", "pattern": "^story_[A-Za-z0-9_-]{4,96}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "allOf": [{ "not": { "pattern": "^/" } }, { "not": { "pattern": "\\\\" } }, { "not": { "pattern": "\\u0000" } }, { "not": { "pattern": ":" } }, { "not": { "pattern": "[*?\\[\\]{}]" } }, { "not": { "pattern": "[<>\"|]" } }, { "not": { "pattern": "(?:^|/)(?:\\.{1,2}|)(?:/|$)" } }, { "not": { "pattern": "(?:^|/)[^/]*[. ](?:/|$)" } }, { "not": { "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)" } }] },
    "change": { "type": "object", "additionalProperties": false, "required": ["path", "operations"], "properties": { "path": { "$ref": "#/$defs/path" }, "operations": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["CREATE", "MODIFY", "DELETE"] } } } },
    "story": { "type": "object", "additionalProperties": false, "required": ["story_id", "title", "objective", "priority", "depends_on", "allowed_changes", "validation_ids", "acceptance_criteria", "required_capabilities", "context_budget_bytes", "max_changed_lines", "max_steps", "max_attempts", "story_hash"], "properties": { "story_id": { "$ref": "#/$defs/storyId" }, "title": { "type": "string", "minLength": 1, "maxLength": 160 }, "objective": { "type": "string", "minLength": 1, "maxLength": 2000 }, "priority": { "type": "integer", "minimum": 1, "maximum": 10000 }, "depends_on": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/storyId" } }, "allowed_changes": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/change" } }, "validation_ids": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }, "acceptance_criteria": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }, "required_capabilities": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$" } }, "context_budget_bytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 }, "max_changed_lines": { "type": "integer", "minimum": 1, "maximum": 100000 }, "max_steps": { "type": "integer", "minimum": 1, "maximum": 128 }, "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 }, "story_hash": { "$ref": "#/$defs/hash" } } }
  }
}
