{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-worker-capability-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_ref", "deployment", "capabilities", "limits", "worker_capability_hash"],
  "properties": {
    "schema_version": { "const": 4 },
    "binding_ref": { "$ref": "#/$defs/id" },
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_ref", "model_ref", "model_revision", "model_artifact_hash", "endpoint_revision", "harness_ref", "harness_revision", "tool_protocol", "tool_parser_revision", "tool_bundle_hash", "instruction_bundle_hash", "qualification_evidence_hash"],
      "properties": {
        "provider_ref": { "$ref": "#/$defs/id" }, "model_ref": { "$ref": "#/$defs/id" }, "model_revision": { "$ref": "#/$defs/revision" },
        "model_artifact_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "endpoint_revision": { "$ref": "#/$defs/revision" },
        "harness_ref": { "$ref": "#/$defs/id" }, "harness_revision": { "$ref": "#/$defs/revision" }, "tool_protocol": { "$ref": "#/$defs/id" },
        "tool_parser_revision": { "$ref": "#/$defs/revision" }, "tool_bundle_hash": { "$ref": "#/$defs/hash" }, "instruction_bundle_hash": { "$ref": "#/$defs/hash" }, "qualification_evidence_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "capabilities": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_story_files", "max_story_changed_lines", "max_story_context_bytes", "max_acceptance_criteria", "max_dependency_depth", "max_steps_per_attempt", "max_attempts", "no_progress_repeat_limit"],
      "properties": {
        "max_story_files": { "type": "integer", "minimum": 1, "maximum": 64 }, "max_story_changed_lines": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_story_context_bytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 }, "max_acceptance_criteria": { "type": "integer", "minimum": 1, "maximum": 32 },
        "max_dependency_depth": { "type": "integer", "minimum": 0, "maximum": 32 }, "max_steps_per_attempt": { "type": "integer", "minimum": 1, "maximum": 128 }, "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "no_progress_repeat_limit": { "type": "integer", "minimum": 2, "maximum": 3 }
      }
    },
    "worker_capability_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$" },
    "revision": { "allOf": [{ "$ref": "#/$defs/id" }, { "not": { "type": "string", "pattern": "^(?:[Aa][Uu][Tt][Oo]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee])$" } }] }
  }
}
