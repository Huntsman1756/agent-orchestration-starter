{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-result-v4.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["run_id", "request_id", "state", "effective_route", "route_decision_hash", "effective_data_scope", "effective_source_sensitivity", "branch", "base_sha", "head_sha", "contract_hash", "policy_hash", "profile_hash", "attempts", "validation_results", "diff_hash", "tree_hash", "changed_files", "review_attestation_hash", "commit_sha", "failure", "artifact_manifest_hash"],
  "properties": {
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]{16,96}$" }, "request_id": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{16,96}$" }, "state": { "$ref": "#/$defs/id" }, "effective_route": { "enum": ["ECONOMY", "FRONTIER"] }, "route_decision_hash": { "$ref": "#/$defs/hash" }, "effective_data_scope": { "const": "SOURCE_CODE_ONLY" }, "effective_source_sensitivity": { "enum": ["PUBLIC", "PRIVATE"] }, "branch": { "type": "string", "minLength": 1, "maxLength": 512 }, "base_sha": { "$ref": "#/$defs/sha" }, "head_sha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] }, "contract_hash": { "$ref": "#/$defs/hash" }, "policy_hash": { "$ref": "#/$defs/hash" }, "profile_hash": { "$ref": "#/$defs/hash" }, "attempts": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/attempt" } }, "validation_results": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/validationResult" } }, "diff_hash": { "$ref": "#/$defs/hash" }, "tree_hash": { "$ref": "#/$defs/hash" }, "changed_files": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }, "review_attestation_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "commit_sha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] }, "failure": { "anyOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }] }, "artifact_manifest_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }, "attempt": { "type": "object", "additionalProperties": false, "required": ["attempt", "executor_binding_ref", "result_hash"], "properties": { "attempt": { "type": "integer", "minimum": 1 }, "executor_binding_ref": { "$ref": "#/$defs/id" }, "result_hash": { "$ref": "#/$defs/hash" } } }, "validationResult": { "type": "object", "additionalProperties": false, "required": ["validation_id", "exit_code", "result_hash"], "properties": { "validation_id": { "$ref": "#/$defs/id" }, "exit_code": { "type": "integer" }, "result_hash": { "$ref": "#/$defs/hash" } } }, "failure": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable", "evidence_hashes"], "properties": { "code": { "enum": ["INVALID_CONTRACT", "REPOSITORY_NOT_ALLOWED", "REPOSITORY_BUSY", "BROKER_STATE_CORRUPT", "BASE_SHA_INVALID", "WORKTREE_CREATION_FAILED", "CAPABILITY_UNVERIFIED", "SOURCE_SENSITIVITY_UNSUPPORTED", "PROCESS_SANDBOX_UNAVAILABLE", "REVIEW_SANDBOX_UNAVAILABLE", "AUTHENTICATION_FAILED", "PROVIDER_UNAVAILABLE", "EXECUTOR_INVALID_OUTPUT", "EXECUTOR_POLICY_VIOLATION", "OUT_OF_SCOPE_CHANGE", "VALIDATION_FAILED", "REVIEW_REJECTED", "REVIEW_ATTESTATION_INVALID", "EVIDENCE_HASH_MISMATCH", "FINALIZATION_ISOLATION_FAILED", "FINALIZATION_FAILED", "PUBLICATION_POLICY_DENIED", "PUBLICATION_FAILED", "ABORTED", "UNKNOWN_FAILURE"] }, "message": { "type": "string", "minLength": 1, "maxLength": 2000 }, "retryable": { "type": "boolean" }, "evidence_hashes": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } } } } }
}
