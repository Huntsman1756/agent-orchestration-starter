{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/benchmark-observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "caseFingerprint", "taskClass", "attemptedRoute", "firstPassAccepted", "finalAccepted", "totalCostUsd", "latencyMs", "repairCount", "escalated", "postAcceptanceDefective", "postAcceptanceDefects", "frontierTokens", "economyTokens"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "taskId": { "type": "string", "minLength": 1 },
    "caseFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "taskClass": { "type": "string", "minLength": 1 },
    "attemptedRoute": { "enum": ["economy_only", "orchestrated", "frontier_execution"] },
    "firstPassAccepted": { "type": "boolean" },
    "finalAccepted": { "type": "boolean" },
    "totalCostUsd": { "type": "number", "minimum": 0 },
    "latencyMs": { "type": "integer", "minimum": 0 },
    "repairCount": { "type": "integer", "minimum": 0 },
    "escalated": { "type": "boolean" },
    "postAcceptanceDefective": { "type": "boolean" },
    "postAcceptanceDefects": { "type": "array", "items": { "$ref": "#/$defs/defect" } },
    "frontierTokens": { "$ref": "#/$defs/tokens" },
    "economyTokens": { "$ref": "#/$defs/tokens" }
  },
  "allOf": [
    {
      "if": { "properties": { "firstPassAccepted": { "const": true } }, "required": ["firstPassAccepted"] },
      "then": { "properties": { "finalAccepted": { "const": true } } }
    },
    {
      "if": { "properties": { "escalated": { "const": true } }, "required": ["escalated"] },
      "then": { "properties": { "firstPassAccepted": { "const": false } } }
    },
    {
      "if": { "properties": { "finalAccepted": { "const": false } }, "required": ["finalAccepted"] },
      "then": {
        "properties": {
          "postAcceptanceDefective": { "const": false },
          "postAcceptanceDefects": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "postAcceptanceDefective": { "const": true } }, "required": ["postAcceptanceDefective"] },
      "then": { "properties": { "postAcceptanceDefects": { "type": "array", "minItems": 1 } } },
      "else": { "properties": { "postAcceptanceDefects": { "type": "array", "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "description"],
      "properties": {
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
