{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-repository-policy-v4.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "base", "worktrees", "routing", "validation", "sourcePolicy", "sandbox", "instructions"],
  "properties": {
    "schemaVersion": { "const": 4 }, "repositoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "base": { "type": "object", "additionalProperties": false, "required": ["allowedBranches"], "properties": { "allowedBranches": { "$ref": "#/$defs/idList64Required" } } },
    "worktrees": { "type": "object", "additionalProperties": false, "required": ["parentRef"], "properties": { "parentRef": { "$ref": "#/$defs/id" } } },
    "routing": { "type": "object", "additionalProperties": false, "required": ["frontierOnly"], "properties": { "frontierOnly": { "type": "object", "additionalProperties": false, "required": ["riskClasses", "taskClasses", "paths", "sourceSensitivity"], "properties": { "riskClasses": { "$ref": "#/$defs/idList64" }, "taskClasses": { "$ref": "#/$defs/idList64" }, "paths": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "allOf": [{ "$ref": "#/$defs/normalizedRepositoryPath" }, { "type": "string", "maxLength": 512 }] } }, "sourceSensitivity": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["PUBLIC", "PRIVATE"] } } } } } },
    "validation": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/validation" }, "propertyNames": { "$ref": "#/$defs/id" } },
    "sourcePolicy": { "type": "object", "additionalProperties": false, "required": ["dataScope", "sourceSensitivity"], "properties": { "dataScope": { "const": "SOURCE_CODE_ONLY" }, "sourceSensitivity": { "enum": ["PUBLIC", "PRIVATE"] } } },
    "sandbox": { "type": "object", "additionalProperties": false, "required": ["requiredBackend", "requiredProfiles"], "properties": { "requiredBackend": { "$ref": "#/$defs/id" }, "requiredProfiles": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "instructions": { "type": "object", "additionalProperties": false, "required": ["approvedSources"], "properties": { "approvedSources": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "allOf": [{ "$ref": "#/$defs/normalizedRepositoryPath" }, { "type": "string", "maxLength": 512 }] } } } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idList64": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "idList64Required": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "validation": { "type": "object", "additionalProperties": false, "required": ["argv", "workingDirectory", "timeoutSeconds", "sandboxProfile"], "properties": { "argv": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/id" } }, "workingDirectory": { "type": "string", "minLength": 1, "maxLength": 512 }, "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }, "sandboxProfile": { "$ref": "#/$defs/id" } } },
    "normalizedRepositoryPath": { "type": "string", "minLength": 1, "allOf": [
      { "not": { "type": "string", "pattern": "^/" } },
      { "not": { "type": "string", "pattern": "\\\\" } },
      { "not": { "type": "string", "pattern": "\\u0000" } },
      { "not": { "type": "string", "pattern": ":" } },
      { "not": { "type": "string", "pattern": "[*?\\[\\]{}]" } },
      { "not": { "type": "string", "pattern": "[<>\"|]" } },
      { "not": { "type": "string", "pattern": "(?:^|/)(?:\\.{1,2}|)(?:/|$)" } },
      { "not": { "type": "string", "pattern": "(?:^|/)[^/]*[. ](?:/|$)" } },
      { "not": { "type": "string", "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)" } }
    ] }
  }
}
