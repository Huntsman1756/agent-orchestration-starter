{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/routing-gate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselineRoute", "candidateRoutes", "minSamplesPerRoute", "minAcceptedTaskCostSavingsRate", "maxFirstPassAcceptanceDropRate", "maxEscalationRate", "maxPostAcceptanceDefectRate"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baselineRoute": { "$ref": "#/$defs/route" },
    "candidateRoutes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/route" } },
    "minSamplesPerRoute": { "type": "integer", "minimum": 1 },
    "minAcceptedTaskCostSavingsRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "maxFirstPassAcceptanceDropRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "maxEscalationRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "maxPostAcceptanceDefectRate": { "type": "number", "minimum": 0 }
  },
  "$defs": { "route": { "enum": ["economy_only", "orchestrated", "frontier_execution"] } }
}
