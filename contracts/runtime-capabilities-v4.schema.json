{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-capabilities-v4.schema.json",
  "oneOf": [{ "$ref": "#/$defs/contract" }, { "$ref": "#/$defs/adapter" }],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "efforts": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "contract": { "type": "object", "additionalProperties": false, "required": ["schema_version", "contract_id", "role", "structured_output", "tool_protocol", "filesystem", "network", "context_mode", "max_steps", "reasoning_efforts", "temperature_control", "contract_hash"], "properties": { "schema_version": { "const": 4 }, "contract_id": { "$ref": "#/$defs/id" }, "role": { "enum": ["ORCHESTRATOR", "ECONOMY_EXECUTOR", "FRONTIER_EXECUTOR", "REVIEWER"] }, "structured_output": { "type": "boolean" }, "tool_protocol": { "enum": ["NONE", "NATIVE"] }, "filesystem": { "enum": ["NONE", "READ_ONLY", "CONTRACT_WRITE"] }, "network": { "enum": ["DENIED", "BROKER_GATEWAY"] }, "context_mode": { "enum": ["FRESH_PER_ATTEMPT", "PERSISTENT"] }, "max_steps": { "type": "integer", "minimum": 1, "maximum": 128 }, "reasoning_efforts": { "$ref": "#/$defs/efforts" }, "temperature_control": { "type": "boolean" }, "contract_hash": { "$ref": "#/$defs/hash" } } },
    "adapter": { "type": "object", "additionalProperties": false, "required": ["schema_version", "adapter_id", "structured_output", "tool_protocols", "filesystems", "networks", "context_modes", "max_steps", "reasoning_efforts", "temperature_control", "capability_hash"], "properties": { "schema_version": { "const": 4 }, "adapter_id": { "$ref": "#/$defs/id" }, "structured_output": { "type": "boolean" }, "tool_protocols": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["NONE", "NATIVE"] } }, "filesystems": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["NONE", "READ_ONLY", "CONTRACT_WRITE"] } }, "networks": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["DENIED", "BROKER_GATEWAY"] } }, "context_modes": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["FRESH_PER_ATTEMPT", "PERSISTENT"] } }, "max_steps": { "type": "integer", "minimum": 1, "maximum": 128 }, "reasoning_efforts": { "$ref": "#/$defs/efforts" }, "temperature_control": { "type": "boolean" }, "capability_hash": { "$ref": "#/$defs/hash" } } }
  }
}
