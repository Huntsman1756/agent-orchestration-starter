{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-work-contract-v4.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "request_id", "run_id", "repository_id", "repository_root_hash", "base_sha", "objective", "task_class", "requested_risk_class", "effective_risk_class", "requested_route", "effective_route", "route_decision_reasons", "route_decision_hash", "effective_data_scope", "effective_source_sensitivity", "allowed_changes", "allowed_validation_ids", "inputs", "constraints", "success_criteria", "max_files_changed", "max_changed_lines", "max_attempts", "sandbox_profile_hashes", "prohibited_actions", "result_schema_version", "policy_hash", "profile_hash", "contract_hash"],
  "properties": {
    "schema_version": { "const": 4 }, "task_id": { "$ref": "#/$defs/id" }, "request_id": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{16,96}$" }, "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]{16,96}$" }, "repository_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }, "repository_root_hash": { "$ref": "#/$defs/hash" }, "base_sha": { "$ref": "#/$defs/sha" }, "objective": { "type": "string", "minLength": 1, "maxLength": 4000 }, "task_class": { "$ref": "#/$defs/id" }, "requested_risk_class": { "$ref": "#/$defs/id" }, "effective_risk_class": { "$ref": "#/$defs/id" }, "requested_route": { "enum": ["AUTO", "ECONOMY", "FRONTIER"] }, "effective_route": { "enum": ["ECONOMY", "FRONTIER"] }, "route_decision_reasons": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }, "route_decision_hash": { "$ref": "#/$defs/hash" }, "effective_data_scope": { "const": "SOURCE_CODE_ONLY" }, "effective_source_sensitivity": { "enum": ["PUBLIC", "PRIVATE"] }, "allowed_changes": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/allowedChange" } }, "allowed_validation_ids": { "$ref": "#/$defs/idList64Required" }, "inputs": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 2000 } }, "constraints": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 2000 } }, "success_criteria": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "maxLength": 2000 } }, "max_files_changed": { "type": "integer", "minimum": 1, "maximum": 256 }, "max_changed_lines": { "type": "integer", "minimum": 1, "maximum": 100000 }, "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 }, "sandbox_profile_hashes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hash" }, "propertyNames": { "$ref": "#/$defs/id" } }, "prohibited_actions": { "$ref": "#/$defs/idList64" }, "result_schema_version": { "const": 4 }, "policy_hash": { "$ref": "#/$defs/hash" }, "profile_hash": { "$ref": "#/$defs/hash" }, "contract_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }, "idList64": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "idList64Required": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "allowedChange": { "type": "object", "additionalProperties": false, "required": ["path", "operations"], "properties": { "path": { "type": "string", "minLength": 1 }, "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["CREATE", "MODIFY", "DELETE"] } } } } }
}
