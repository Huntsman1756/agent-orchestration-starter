{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "assignments"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "assignments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "executor", "reviewer"],
      "properties": {
        "orchestrator": { "$ref": "#/$defs/assignment" },
        "executor": { "$ref": "#/$defs/assignment" },
        "reviewer": { "$ref": "#/$defs/assignment" }
      }
    }
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "tier", "reasoningEffort", "capabilities"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "harnessProviders": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codex": { "type": "string", "minLength": 1 },
            "opencode": { "type": "string", "minLength": 1 },
            "hermes": { "type": "string", "minLength": 1 }
          }
        },
        "model": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["frontier", "economy"] },
        "reasoningEffort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
        "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "qualification": { "$ref": "#/$defs/qualification" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyVersion", "status", "cleanRuns", "requiredCleanRuns", "evidenceHash"],
      "properties": {
        "policyVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["VERIFIED", "UNQUALIFIED"] },
        "cleanRuns": { "type": "integer", "minimum": 0 },
        "requiredCleanRuns": { "const": 3 },
        "evidenceHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    }
  }
}
