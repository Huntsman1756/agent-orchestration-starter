{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-repair-packet-v4.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "story_id", "failed_attempt", "findings", "packet_hash"],
  "properties": {
    "schema_version": { "const": 4 }, "story_id": { "type": "string", "pattern": "^story_[A-Za-z0-9_-]{4,96}$" },
    "failed_attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "findings": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/finding" } },
    "packet_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "allOf": [{ "not": { "pattern": "^/" } }, { "not": { "pattern": "\\\\" } }, { "not": { "pattern": ":" } }, { "not": { "pattern": "(?:^|/)(?:\\.{1,2})(?:/|$)" } }] },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "source", "category_code", "path", "line", "instruction", "evidence_hash"],
      "allOf": [{ "if": { "properties": { "path": { "type": "null" } }, "required": ["path"] }, "then": { "properties": { "line": { "type": "null" } } } }],
      "properties": {
        "finding_id": { "$ref": "#/$defs/id" }, "source": { "enum": ["VALIDATION", "REVIEW"] }, "category_code": { "$ref": "#/$defs/id" },
        "path": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] }, "line": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 10000000 }, { "type": "null" }] },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 512 }, "evidence_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
