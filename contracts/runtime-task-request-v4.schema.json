{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-task-request-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "request_id", "repository_id", "objective", "task_class", "requested_risk_class", "requested_route", "allowed_changes", "acceptance_tests", "implementation_targets", "allowed_validation_ids", "inputs", "constraints", "success_criteria", "max_files_changed", "max_changed_lines", "max_attempts", "prohibited_actions", "result_schema_version"],
  "properties": {
    "schema_version": { "const": 4 },
    "task_id": { "$ref": "#/$defs/id" },
    "request_id": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{16,96}$" },
    "repository_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "task_class": { "$ref": "#/$defs/id" },
    "requested_risk_class": { "$ref": "#/$defs/id" },
    "requested_route": { "enum": ["AUTO", "ECONOMY", "FRONTIER"] },
    "execution_requirements": { "$ref": "#/$defs/executionRequirements" },
    "allowed_changes": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/allowedChange" } },
    "acceptance_tests": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/acceptanceTestPath" } },
    "implementation_targets": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/implementationTarget" } },
    "allowed_validation_ids": { "$ref": "#/$defs/idList64Required" },
    "inputs": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 2000 } },
    "constraints": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 2000 } },
    "success_criteria": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "maxLength": 2000 } },
    "max_files_changed": { "type": "integer", "minimum": 1, "maximum": 256 },
    "max_changed_lines": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
    "prohibited_actions": { "$ref": "#/$defs/idList64" },
    "result_schema_version": { "const": 4 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idList64": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "idList64Required": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "taskTrait": { "enum": ["mechanical", "localized", "semantic-debugging", "cross-file-reasoning", "multimodal", "long-horizon", "architecture", "security-sensitive", "migration"] },
    "executionRequirements": { "type": "object", "additionalProperties": false, "required": ["taskTraits", "contextBytes", "acceptanceCriteriaCount"], "properties": { "taskTraits": { "type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "items": { "$ref": "#/$defs/taskTrait" } }, "contextBytes": { "type": "integer", "minimum": 0, "maximum": 16777216 }, "acceptanceCriteriaCount": { "type": "integer", "minimum": 1, "maximum": 64 } } },
    "allowedChange": { "type": "object", "additionalProperties": false, "required": ["path", "operations"], "properties": { "path": { "$ref": "#/$defs/normalizedRepositoryPath" }, "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["CREATE", "MODIFY", "DELETE"] } } } },
    "implementationTarget": { "type": "object", "additionalProperties": false, "required": ["path", "operations"], "properties": { "path": { "$ref": "#/$defs/implementationPath" }, "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["CREATE", "MODIFY", "DELETE"] } } } },
    "acceptanceTestPath": { "allOf": [{ "$ref": "#/$defs/normalizedRepositoryPath" }, { "type": "string", "pattern": "\\.(?:spec|test)\\.tsx?$" }] },
    "implementationPath": { "allOf": [{ "$ref": "#/$defs/normalizedRepositoryPath" }, { "type": "string", "pattern": "\\.tsx?$", "not": { "pattern": "\\.(?:spec|test)\\.tsx?$" } }] },
    "normalizedRepositoryPath": { "type": "string", "minLength": 1, "allOf": [
      { "not": { "type": "string", "pattern": "^/" } },
      { "not": { "type": "string", "pattern": "\\\\" } },
      { "not": { "type": "string", "pattern": "\\u0000" } },
      { "not": { "type": "string", "pattern": ":" } },
      { "not": { "type": "string", "pattern": "[*?\\[\\]{}]" } },
      { "not": { "type": "string", "pattern": "[<>\"|]" } },
      { "not": { "type": "string", "pattern": "(?:^|/)(?:\\.{1,2}|)(?:/|$)" } },
      { "not": { "type": "string", "pattern": "(?:^|/)[^/]*[. ](?:/|$)" } },
      { "not": { "type": "string", "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)" } }
    ] }
  }
}
