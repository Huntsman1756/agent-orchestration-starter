{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-profile-v4.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "bindings", "runtime"],
  "properties": {
    "schemaVersion": { "const": 4 }, "id": { "$ref": "#/$defs/id" },
    "bindings": { "type": "object", "additionalProperties": false, "required": ["orchestrator", "executor", "escalationExecutor", "frontierExecutor", "reviewer"], "properties": { "orchestrator": { "$ref": "#/$defs/binding" }, "executor": { "$ref": "#/$defs/binding" }, "escalationExecutor": { "$ref": "#/$defs/binding" }, "frontierExecutor": { "$ref": "#/$defs/binding" }, "reviewer": { "$ref": "#/$defs/binding" } } },
    "runtime": { "type": "object", "additionalProperties": false, "required": ["maxArliParallelRequests", "maxConcurrentRunsPerRepository"], "properties": { "maxArliParallelRequests": { "type": "integer", "minimum": 1, "maximum": 64 }, "maxConcurrentRunsPerRepository": { "type": "integer", "minimum": 1, "maximum": 64 } } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "binding": { "type": "object", "additionalProperties": false, "required": ["harness", "provider", "model", "capability", "allowedDataScopes", "allowedSourceSensitivity", "permissions"], "properties": { "harness": { "$ref": "#/$defs/id" }, "provider": { "$ref": "#/$defs/id" }, "model": { "$ref": "#/$defs/id" }, "capability": { "$ref": "#/$defs/id" }, "allowedDataScopes": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "SOURCE_CODE_ONLY" } }, "allowedSourceSensitivity": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["PUBLIC", "PRIVATE"] } }, "permissions": { "enum": ["read-only", "contract-write"] } } }
  }
}
