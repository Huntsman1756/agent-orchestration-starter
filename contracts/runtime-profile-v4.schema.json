{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-profile-v4.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "bindings", "runtime"],
  "properties": {
    "schemaVersion": { "const": 4 }, "id": { "$ref": "#/$defs/id" },
    "bindings": { "type": "object", "additionalProperties": false, "required": ["orchestrator", "executor", "escalationExecutor", "frontierExecutor", "reviewer"], "properties": { "orchestrator": { "$ref": "#/$defs/binding" }, "executor": { "$ref": "#/$defs/binding" }, "escalationExecutor": { "$ref": "#/$defs/binding" }, "frontierExecutor": { "$ref": "#/$defs/binding" }, "reviewer": { "$ref": "#/$defs/binding" } } },
    "runtime": { "type": "object", "additionalProperties": false, "required": ["maxEconomyParallelRequests", "maxConcurrentRunsPerRepository"], "properties": { "maxEconomyParallelRequests": { "type": "integer", "minimum": 1, "maximum": 64 }, "maxConcurrentRunsPerRepository": { "type": "integer", "minimum": 1, "maximum": 64 } } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "binding": { "type": "object", "additionalProperties": false, "required": ["harness", "provider", "model", "capability", "allowedDataScopes", "allowedSourceSensitivity", "permissions", "guidance"], "properties": { "harness": { "$ref": "#/$defs/id" }, "provider": { "$ref": "#/$defs/id" }, "model": { "$ref": "#/$defs/id" }, "authentication": { "enum": ["provider-api-key", "chatgpt-subscription"] }, "capability": { "$ref": "#/$defs/id" }, "allowedDataScopes": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "SOURCE_CODE_ONLY" } }, "allowedSourceSensitivity": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["PUBLIC", "PRIVATE"] } }, "permissions": { "enum": ["read-only", "contract-write"] }, "guidance": { "$ref": "#/$defs/guidance" } }, "allOf": [{ "if": { "required": ["authentication"], "properties": { "authentication": { "const": "chatgpt-subscription" } } }, "then": { "properties": { "harness": { "const": "codex" }, "permissions": { "const": "read-only" } } } }] },
    "guidance": { "type": "object", "additionalProperties": false, "required": ["id", "revision", "sourceUrls", "promptFormat", "contextPlacement", "reasoningEffort", "textVerbosity", "temperature", "maxSteps", "instructions"], "properties": { "id": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/id" }, "sourceUrls": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "maxLength": 2048, "pattern": "^https://[^ ]+$" } }, "promptFormat": { "enum": ["plain", "markdown", "xml"] }, "contextPlacement": { "enum": ["before-task", "after-task"] }, "reasoningEffort": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" }, "textVerbosity": { "enum": ["low", "medium", "high"] }, "temperature": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 2 }, { "type": "null" }] }, "maxSteps": { "type": "integer", "minimum": 1, "maximum": 128 }, "instructions": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } } } }
  }
}
