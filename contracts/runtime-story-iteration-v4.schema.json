{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-orchestration/runtime-story-iteration-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "run_id", "plan_hash", "story_id", "iteration", "attempt", "session_id", "input_tree_hash", "candidate_tree_hash", "outcome", "changes", "changed_lines", "execution_result_hash", "validation_manifest_hash", "review_attestation_hash", "finding_hashes", "repair_packet_hash", "failure_signature_hash", "escalation_reason", "event_hash"],
  "properties": {
    "schema_version": { "const": 4 },
    "type": { "const": "STORY_ITERATION_RECORDED" },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]{16,96}$" },
    "plan_hash": { "$ref": "#/$defs/hash" },
    "story_id": { "type": "string", "pattern": "^story_[A-Za-z0-9_-]{4,96}$" },
    "iteration": { "type": "integer", "minimum": 1, "maximum": 64 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "session_id": { "type": "string", "pattern": "^session_[A-Za-z0-9_-]{16,96}$" },
    "input_tree_hash": { "$ref": "#/$defs/hash" },
    "candidate_tree_hash": { "$ref": "#/$defs/hash" },
    "outcome": { "enum": ["ACCEPTED", "RETRY", "ESCALATE"] },
    "changes": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["path", "operation"], "properties": { "path": { "$ref": "#/$defs/path" }, "operation": { "enum": ["CREATE", "MODIFY", "DELETE"] } } } },
    "changed_lines": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "execution_result_hash": { "$ref": "#/$defs/hash" },
    "validation_manifest_hash": { "$ref": "#/$defs/hash" },
    "review_attestation_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "finding_hashes": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "repair_packet_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "failure_signature_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "escalation_reason": { "anyOf": [{ "enum": ["ATTEMPT_LIMIT", "NO_PROGRESS"] }, { "type": "null" }] },
    "event_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "allOf": [{ "not": { "pattern": "^/" } }, { "not": { "pattern": "\\\\" } }, { "not": { "pattern": "\\u0000" } }, { "not": { "pattern": ":" } }, { "not": { "pattern": "[*?\\[\\]{}]" } }, { "not": { "pattern": "[<>\"|]" } }, { "not": { "pattern": "(?:^|/)(?:\\.{1,2}|)(?:/|$)" } }, { "not": { "pattern": "(?:^|/)[^/]*[. ](?:/|$)" } }, { "not": { "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)" } }] }
  }
}
