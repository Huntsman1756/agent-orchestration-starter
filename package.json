{
  "name": "agent-orchestration-starter",
  "version": "0.2.0",
  "description": "Provider-neutral agent orchestration runtime and control plane",
  "license": "MIT",
  "type": "module",
  "files": [
    "contracts/**",
    "dist/**",
    "docs/**",
    "examples/**",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "native/**",
    "orchestration.yaml",
    "policies/**",
    "profiles/**",
    "routing-gate.yaml",
    "scripts/build-linux-native-helper.mjs",
    "scripts/build-host-bundle.mjs",
    "README.md",
    "SECURITY.md"
  ],
  "bin": {
    "agent-orchestration": "dist/cli/main.js"
  },
  "exports": {
    "./fingerprint": {
      "types": "./dist/routing/fingerprint.d.ts",
      "import": "./dist/routing/fingerprint.js"
    },
    "./pilot-v3": {
      "types": "./dist/pilot/index.d.ts",
      "import": "./dist/pilot/index.js"
    },
    "./dogfood-v1": {
      "types": "./dist/pilot/dogfood-manifest.d.ts",
      "import": "./dist/pilot/dogfood-manifest.js"
    },
    "./runtime-v4": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime-v4/contracts": {
      "types": "./dist/runtime/contract-api.d.ts",
      "import": "./dist/runtime/contract-api.js"
    },
    "./runtime-v4/host": {
      "types": "./dist/runtime/host-api.d.ts",
      "import": "./dist/runtime/host-api.js"
    },
    "./runtime-v4/experimental": {
      "types": "./dist/runtime/experimental.d.ts",
      "import": "./dist/runtime/experimental.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:native && npm run build:host",
    "build:host": "node scripts/build-host-bundle.mjs",
    "build:native": "node scripts/build-linux-native-helper.mjs",
    "build:sbom": "node scripts/generate-sbom.mjs",
    "prepack": "node scripts/build-linux-native-helper.mjs --clean-only && tsc -p tsconfig.json && node scripts/build-linux-native-helper.mjs --for-package && npm run build:host",
    "pretest": "npm run build:native && npm run build:host",
    "test": "node scripts/run-tests.mjs",
    "test:autonomous": "tsx --test tests/runtime-autonomous-dispatcher.test.ts tests/runtime-autonomous-dispatcher-model.test.ts",
    "test:hostile": "tsx --test tests/runtime-docker-sandbox.test.ts tests/runtime-sandbox-hostile.test.ts",
    "example:reference-e2e": "tsx --test tests/runtime-reference-host-e2e.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "validate": "npm run test && npm run typecheck && npm run build",
    "prepublishOnly": "npm run validate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "ajv": "^8.20.0",
    "esbuild": "0.28.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
