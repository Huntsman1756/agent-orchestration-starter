{
  "name": "agent-orchestration-starter",
  "version": "0.1.0",
  "description": "Provider-agnostic agent role compiler for Codex, OpenCode, and Hermes",
  "type": "module",
  "bin": {
    "agent-orchestration": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run test && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
