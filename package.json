{
  "name": "agent-orchestration-starter",
  "version": "0.1.0",
  "description": "Provider-agnostic agent role compiler for Codex, OpenCode, and Hermes",
  "type": "module",
  "files": [
    "contracts/**",
    "dist/**",
    "docs/runtime-broker-quarantine-remediation.md",
    "examples/**",
    "native/**",
    "orchestration.yaml",
    "policies/**",
    "profiles/**",
    "routing-gate.yaml",
    "scripts/build-linux-native-helper.mjs",
    "README.md"
  ],
  "bin": {
    "agent-orchestration": "dist/cli/main.js"
  },
  "exports": {
    "./fingerprint": {
      "types": "./dist/routing/fingerprint.d.ts",
      "import": "./dist/routing/fingerprint.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:native",
    "build:native": "node scripts/build-linux-native-helper.mjs",
    "prepack": "node scripts/build-linux-native-helper.mjs --clean-only && tsc -p tsconfig.json && node scripts/build-linux-native-helper.mjs --for-package",
    "pretest": "npm run build:native",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "validate": "npm run test && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "ajv": "^8.20.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
